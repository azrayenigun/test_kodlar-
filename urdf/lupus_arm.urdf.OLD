  </link>

  <gazebo reference="Joint_1_Link"><material>Gazebo/DarkGrey</material><self_collide>true</self_collide></gazebo>


  <joint name="Joint_2" type="revolute">

    <origin xyz="0 0 0.06" rpy="1.5707 0 -3.1415" />

    <parent link="Joint_1_Link" /><child link="Joint_2_Link" />

    <axis xyz="0 0 -1" /><limit lower="-1.57" upper="4.71" effort="300" velocity="0.8" />

  </joint>

  <link name="Joint_2_Link">

    <inertial><origin xyz="0 0 0" rpy="0 0 0" /><mass value="1.755" /><inertia ixx="0.031" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.032" /></inertial>

    <visual><geometry><mesh filename="package://arc_rover_autonomy/meshes/Joint_2_Link.STL" /></geometry></visual>

