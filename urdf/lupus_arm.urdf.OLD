  </link>

  <gazebo reference="Joint_2_Link"><material>Gazebo/Blue</material><self_collide>true</self_collide></gazebo>


  <joint name="Joint_3" type="revolute">

    <origin xyz="0 0.35 0.025" rpy="0 0 1.6446" />

    <parent link="Joint_2_Link" /><child link="Joint_3_Link" />

    <axis xyz="0 0 1" /><limit lower="-1.57" upper="4.71" effort="300" velocity="0.8" />

