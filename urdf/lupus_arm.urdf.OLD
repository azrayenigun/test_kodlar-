  <gazebo reference="Joint_6_Link"><material>Gazebo/Grey</material><self_collide>true</self_collide></gazebo>


  <joint name="Gripper_Base_joint" type="fixed">

    <origin xyz="0 0 0.129" rpy="0 0 0" />

    <parent link="Joint_6_Link" /><child link="Gripper_Base_Link" />

  </joint>

  <link name="Gripper_Base_Link">

    <inertial><origin xyz="0 0 0" rpy="0 0 0" /><mass value="0.540" /><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0018" iyz="0" izz="0.0017" /></inertial>

    <visual><geometry><mesh filename="package://arc_rover_autonomy/meshes/Gripper_Base_Link.STL" /></geometry></visual>

