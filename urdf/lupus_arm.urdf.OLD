<?xml version="1.0" encoding="utf-8"?>

<robot name="LupusArm">


  <link name="world"/>

  <joint name="world_fixed" type="fixed">

    <parent link="world"/><child link="base_link"/>

    <origin xyz="0 0 0" rpy="0 0 0"/>

  </joint>

  

  <link name="base_link">

    <inertial>

      <origin xyz="1.3503E-17 1.6228E-17 0.0441" rpy="0 0 0" />

      <mass value="8.522" />

      <inertia ixx="0.0424" ixy="0" ixz="0" iyy="0.0424" iyz="0" izz="0.0773" />

    </inertial>

    <visual><geometry><mesh filename="package://arc_rover_autonomy/meshes/base_link.STL" /></geometry></visual>

    <collision><geometry><mesh filename="package://arc_rover_autonomy/meshes/base_link.STL" /></geometry></collision>

  </link>

  <gazebo reference="base_link"><material>Gazebo/Blue</material><self_collide>true</self_collide></gazebo>


  <joint name="Joint_1" type="revolute">

    <origin xyz="0 0 0.1275" rpy="0 0 0" />

    <parent link="base_link" /><child link="Joint_1_Link" />

    <axis xyz="0 0 1" /><limit lower="0" upper="6.28" effort="40" velocity="10.5" />

  </joint>

  <link name="Joint_1_Link">

