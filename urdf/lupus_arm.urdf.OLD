  <link name="Joint_3_Link">

    <inertial><origin xyz="0 0 0" rpy="0 0 0" /><mass value="3.073" /><inertia ixx="0.032" ixy="0" ixz="0" iyy="0.006" iyz="0" izz="0.036" /></inertial>

    <visual><geometry><mesh filename="package://arc_rover_autonomy/meshes/Joint_3_Link.STL" /></geometry></visual>

    <collision><geometry><mesh filename="package://arc_rover_autonomy/meshes/Joint_3_Link.STL" /></geometry></collision>

  </link>

  <gazebo reference="Joint_3_Link"><material>Gazebo/Blue</material><self_collide>true</self_collide></gazebo>


  <joint name="Joint_4" type="revolute">

    <origin xyz="-0.2383 -0.3323 0.075" rpy="0.0738 1.5707 0" />

    <parent link="Joint_3_Link" /><child link="Joint_4_Link" />

    <axis xyz="0 0 1" /><limit lower="0" upper="6.28" effort="6" velocity="3.5" />

  </joint>

  <link name="Joint_4_Link">

    <inertial><origin xyz="0 0 0" rpy="0 0 0" /><mass value="1.845" /><inertia ixx="0.002" ixy="0" ixz="0" iyy="0.004" iyz="0" izz="0.002" /></inertial>

