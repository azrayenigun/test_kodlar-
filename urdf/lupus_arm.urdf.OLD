  </link>

  <gazebo reference="Gripper_Base_Link"><material>Gazebo/DarkGrey</material><self_collide>true</self_collide></gazebo>


  <joint name="Gripper_Joint_1" type="prismatic">

    <origin xyz="0 0 0" rpy="0 0 0" />

    <parent link="Gripper_Base_Link" /><child link="Gripper_Joint_1_Link" />

    <axis xyz="1 0 0" /><limit lower="-0.05" upper="0" effort="3.5" velocity="2.52" />

  </joint>

  <link name="Gripper_Joint_1_Link">

    <inertial><origin xyz="0 0 0" /><mass value="0.1" /><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001" /></inertial>

    <visual><geometry><mesh filename="package://arc_rover_autonomy/meshes/Gripper_Joint_1_Link.STL" /></geometry></visual>

    <collision><geometry><mesh filename="package://arc_rover_autonomy/meshes/Gripper_Joint_1_Link.STL" /></geometry></collision>

  </link>

  <gazebo reference="Gripper_Joint_1_Link"><material>Gazebo/Grey</material></gazebo>


  <joint name="Gripper_Joint_2" type="prismatic">

    <origin xyz="0 0 0" rpy="0 0 0" />

    <parent link="Gripper_Base_Link" /><child link="Gripper_Joint_2_Link" />

    <axis xyz="1 0 0" /><limit lower="0" upper="0.05" effort="3.5" velocity="2.5" />

  </joint>

  <link name="Gripper_Joint_2_Link">

    <inertial><origin xyz="0 0 0" /><mass value="0.1" /><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001" /></inertial>

