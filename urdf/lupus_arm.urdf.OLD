  <link name="Joint_6_Link">

    <inertial><origin xyz="0 0 0" rpy="0 0 0" /><mass value="0.237" /><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002" /></inertial>

