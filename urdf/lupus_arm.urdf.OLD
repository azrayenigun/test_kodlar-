  </link>

  <gazebo reference="Joint_4_Link"><material>Gazebo/DarkGrey</material><self_collide>true</self_collide></gazebo>


  <joint name="Joint_5" type="revolute">

    <origin xyz="0 0 -0.15" rpy="1.5707 0 1.5707" />

    <parent link="Joint_4_Link" /><child link="Joint_5_Link" />

    <axis xyz="0 0 -1" /><limit lower="-6.28" upper="6.28" effort="3.6" velocity="6.2" />

  </joint>

  <link name="Joint_5_Link">

    <inertial><origin xyz="0 0 0" rpy="0 0 0" /><mass value="0.050" /><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001" /></inertial>

    <visual><geometry><mesh filename="package://arc_rover_autonomy/meshes/Joint_5_Link.STL" /></geometry></visual>

    <collision><geometry><mesh filename="package://arc_rover_autonomy/meshes/Joint_5_Link.STL" /></geometry></collision>

  </link>

  <gazebo reference="Joint_5_Link"><material>Gazebo/Grey</material><self_collide>true</self_collide></gazebo>


  <joint name="Joint_6" type="revolute">

    <origin xyz="0 0 0" rpy="1.5707 -1.5707 0" />

    <parent link="Joint_5_Link" /><child link="Joint_6_Link" />

    <axis xyz="0 0 -1" /><limit lower="-6.28" upper="6.28" effort="3.6" velocity="6.8" />

